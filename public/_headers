/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), payment=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self' https://app.cal.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://cal.com https://app.cal.com; frame-src https://cal.com https://app.cal.com; upgrade-insecure-requests

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

/og-context-compression.svg
  Cache-Control: public, max-age=31536000, immutable

/og-workflow-automation.svg
  Cache-Control: public, max-age=31536000, immutable

/og-workflow-automation.png
  Cache-Control: public, max-age=31536000, immutable

/llms.txt
  Cache-Control: public, max-age=3600

/workflow-automation/llms.txt
  Cache-Control: public, max-age=3600

/assets/workflow-automation.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/assets/wexpro-foundations.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/assets/demo.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/assets/workflow-demo.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/assets/workflow-automation.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/assets/asteroid-hero-canvas.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
